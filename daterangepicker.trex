<?xml version="1.0" encoding="utf-8"?>
<!--
  Tableau dashboard extension manifest.

  Before deploying, change <url> to wherever you host this folder and bump
  <dashboard-extension extension-version="..."> whenever you publish a change.
  Tableau caches by the combination of id, version and URL, so two manifests
  sharing all three will not both load in one workbook.
-->
<manifest manifest-version="0.1" xmlns="http://www.tableau.com/xml/extension_manifest">
  <dashboard-extension id="com.aad.extensions.daterangepicker" extension-version="1.0.0">
    <default-locale>en_US</default-locale>
    <name resource-id="name"/>
    <description>Side-by-side calendar range picker that applies an inclusive date range without leaking the day after the end date.</description>
    <author name="American Academy of Dermatology" email="mschieler@aad.org" organization="American Academy of Dermatology" website="https://www.aad.org"/>
    <min-api-version>1.4</min-api-version>
    <source-location>
      <url>http://localhost:8765/index.html</url>
    </source-location>
    <icon></icon>
    <permissions>
      <permission>full data</permission>
    </permissions>
    <context-menu>
      <configure-context-menu-item />
    </context-menu>
  </dashboard-extension>
  <resources>
    <resource id="name">
      <text locale="en_US">Date Range Picker</text>
    </resource>
  </resources>
</manifest>
