<?xml version="1.0" encoding="utf-8"?>
<!--
  Tableau dashboard extension manifest.

  LOCAL DEVELOPMENT COPY.

  Identical to daterangepicker.trex except that <url> points at the local
  server started by serve.cmd, and the display name is suffixed "(local)".
  Use this one while iterating; use daterangepicker.trex for the published
  GitHub Pages build. The two differ by URL, so Tableau treats them as
  distinct extensions and both can coexist.
-->
<manifest manifest-version="0.1" xmlns="http://www.tableau.com/xml/extension_manifest">
  <dashboard-extension id="com.aad.extensions.daterangepicker" extension-version="1.0.0">
    <default-locale>en_US</default-locale>
    <name resource-id="name"/>
    <description>Side-by-side calendar range picker that applies an inclusive date range without leaking the day after the end date.</description>
    <!-- Tableau's manifest parser requires the email attribute, despite the
         published docs describing only name and website as required. It is set
         to a non-personal address so no individual's address is published. -->
    <author name="American Academy of Dermatology" email="noreply@aad.org" organization="American Academy of Dermatology" website="https://www.aad.org"/>
    <min-api-version>1.4</min-api-version>
    <source-location>
      <url>http://localhost:8765/index.html</url>
    </source-location>
    <icon></icon>
    <permissions>
      <permission>full data</permission>
    </permissions>
    <context-menu>
      <configure-context-menu-item />
    </context-menu>
  </dashboard-extension>
  <resources>
    <resource id="name">
      <text locale="en_US">Date Range Picker (local)</text>
    </resource>
  </resources>
</manifest>
